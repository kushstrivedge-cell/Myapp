NODE_ENV=test
# Tests refuse to run unless the database name ends with _test.
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/myapp_test?schema=public"

JWT_ACCESS_SECRET=test-access-secret-that-is-at-least-32-characters
JWT_REFRESH_SECRET=test-refresh-secret-that-is-at-least-32-characters
OTP_SECRET=test-otp-secret-that-is-at-least-32-characters

SMTP_HOST=
FIREBASE_SERVICE_ACCOUNT_JSON=
MOBILE_APP_SCHEME=cartly
