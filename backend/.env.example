NODE_ENV=development
PORT=4000

# Replace the username, password, and database name for your local PostgreSQL setup.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/myapp?schema=public"
# Comma-separated browser origins. Native mobile requests do not send an Origin header.
APP_ORIGIN=http://localhost:5173,http://localhost:3000

# Use different random values of at least 32 characters for each secret.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
OTP_SECRET=replace-with-a-random-otp-secret-at-least-32-characters

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10

# SMTP is optional in development. Without it, OTP codes are logged by the API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cartly <no-reply@cartly.local>"
# Used by order-email buttons to open the mobile order-tracking screen.
MOBILE_APP_SCHEME=cartly

# Paste the complete Firebase service-account JSON on one line to enable FCM push.
FIREBASE_SERVICE_ACCOUNT_JSON=
SUPPORT_EMAIL=support@cartly.local
SUPPORT_PHONE=+911800000000
SUPPORT_CHAT_URL=https://wa.me/911800000000

# Razorpay demo/test mode only. The API refuses keys beginning with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
COD_MAX_ORDER_AMOUNT=5000
COD_BLOCKED_PINCODES=
