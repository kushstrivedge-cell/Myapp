generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUNDED
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  phone             String?            @unique
  passwordHash      String
  role              UserRole           @default(CUSTOMER)
  active            Boolean            @default(true)
  emailVerifiedAt   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  addresses         Address[]
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orders            Order[]
  reviews           Review[]
  notifications     Notification[]
  returns           ReturnRequest[]
  deviceTokens      DeviceToken[]
  supportTickets    SupportTicket[]
  cartCouponCode    String?
  cartCoupon        Coupon?            @relation("UserCartCoupon", fields: [cartCouponCode], references: [code], onDelete: SetNull)
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationCode {
  id         String              @id @default(uuid())
  userId     String
  purpose    VerificationPurpose
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  fullName    String
  phone       String
  addressLine String
  city        String
  state       String
  pincode     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id          String           @id @default(uuid())
  categoryId  String
  name        String
  slug        String           @unique
  description String
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  wishlists   WishlistItem[]
  orderItems  OrderItem[]

  @@index([categoryId, active])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id             String          @id @default(uuid())
  productId      String
  sku            String          @unique
  colour         String?
  size           String?
  price          Decimal         @db.Decimal(12, 2)
  oldPrice       Decimal?        @db.Decimal(12, 2)
  stock          Int             @default(0)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  guestCartItems GuestCartItem[]
  orderItems     OrderItem[]

  @@index([productId])
}

model CartItem {
  id        String         @id @default(uuid())
  userId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id              String             @id @default(uuid())
  number          String             @unique
  userId          String
  status          OrderStatus        @default(PENDING)
  paymentStatus   PaymentStatus      @default(PENDING)
  paymentMethod   String
  shippingMethod  String
  shippingAddress Json
  idempotencyKey  String             @unique
  couponCode      String?
  subtotal        Decimal            @db.Decimal(12, 2)
  discount        Decimal            @default(0) @db.Decimal(12, 2)
  shippingCost    Decimal            @default(0) @db.Decimal(12, 2)
  tax             Decimal            @default(0) @db.Decimal(12, 2)
  total           Decimal            @db.Decimal(12, 2)
  carrier         String?
  trackingNumber  String?
  estimatedDeliveryAt DateTime?
  deliveredAt     DateTime?
  cancellationReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id])
  items           OrderItem[]
  returns         ReturnRequest[]
  timeline        OrderStatusEvent[]
  paymentAttempts PaymentAttempt[]
  refunds         PaymentRefund[]

  @@index([userId, createdAt])
}

model PaymentAttempt {
  id                String   @id @default(uuid())
  orderId           String
  idempotencyKey    String   @unique
  provider          String   @default("RAZORPAY")
  providerOrderId   String   @unique
  providerPaymentId String?  @unique
  status            String   @default("CREATED")
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model PaymentRefund {
  id               String   @id @default(uuid())
  orderId          String
  idempotencyKey   String   @unique
  providerRefundId String?  @unique
  amount           Decimal  @db.Decimal(12, 2)
  status           String   @default("PENDING")
  reason           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model PaymentWebhookEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  message   String
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  productId      String
  variantId      String?
  productName    String
  variantDetails Json?
  unitPrice      Decimal         @db.Decimal(12, 2)
  quantity       Int
  cancelledQuantity Int         @default(0)
  cancellationReason String?
  refundedAmount Decimal        @default(0) @db.Decimal(12, 2)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems    ReturnItem[]

  @@index([orderId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  title     String?
  text      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Coupon {
  id          String      @id @default(uuid())
  code        String      @unique
  percentOff  Int?
  amountOff   Decimal?    @db.Decimal(12, 2)
  minimumCart Decimal?    @db.Decimal(12, 2)
  active      Boolean     @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  userCarts   User[]      @relation("UserCartCoupon")
  guestCarts  GuestCart[]
}

model GuestCart {
  id         String          @id @default(uuid())
  token      String          @unique
  couponCode String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  coupon     Coupon?         @relation(fields: [couponCode], references: [code], onDelete: SetNull)
  items      GuestCartItem[]
}

model GuestCartItem {
  id          String         @id @default(uuid())
  guestCartId String
  variantId   String
  quantity    Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  guestCart   GuestCart      @relation(fields: [guestCartId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([guestCartId, variantId])
  @@index([guestCartId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String    @default("GENERAL")
  data      Json?
  readAt    DateTime?
  pushedAt  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String
  userId       String
  reason       String
  status       ReturnStatus @default(REQUESTED)
  refundAmount Decimal?     @db.Decimal(12, 2)
  refundStatus String       @default("NOT_STARTED")
  adminNote    String?
  pickupAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  items        ReturnItem[]
  events       ReturnStatusEvent[]

  @@index([userId, createdAt])
}

model ReturnStatusEvent {
  id              String        @id @default(uuid())
  returnRequestId String
  status          ReturnStatus
  message         String
  createdAt       DateTime      @default(now())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId, createdAt])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  refundAmount    Decimal       @db.Decimal(12, 2)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([returnRequestId, orderItemId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id        String   @id @default(uuid())
  number    String   @unique
  userId    String
  subject   String
  message   String
  channel   String   @default("APP")
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
